{
  "name": "zohal",
  "version": "0.1.0",
  "description": "an Node.js module for Zohal.io platform",
  "main": "dist/src/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    "require": "./dist/index.js",
    "import": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsc --project ./tsconfig.json && npm run build:esm",
    "build:esm": "gen-esm-wrapper ./dist/index.js ./dist/index.mjs",
    "build:check": "tsc --project ./tsconfig.json --noEmit --incremental false",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.{ts,js,json,yaml,yml}"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EhsanFox/zohal-sdk.git"
  },
  "keywords": [
    "zohal",
    "zohal-sdk",
    "zohal.io"
  ],
  "author": "Ehsan Golmakani",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/EhsanFox/zohal-sdk/issues"
  },
  "homepage": "https://github.com/EhsanFox/zohal-sdk#readme",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.19.9",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^9.39.4",
    "gen-esm-wrapper": "^1.1.3",
    "prettier": "^3.9.4",
    "ts-node": "^10.9.2",
    "typescript": "^4.7.4"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "class-validator": "^0.15.1"
  }
}
